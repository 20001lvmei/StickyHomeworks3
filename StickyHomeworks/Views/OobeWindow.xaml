<Window x:Class="StickyHomeworks.Views.OobeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StickyHomeworks3" Height="600" Width="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="/Assets/AppLogo.ico"
        FontFamily="Microsoft YaHei UI"
        Background="#FFF7FAFF">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="/Assets/AppLogo.png" Width="64" Height="64" VerticalAlignment="Top"/>
            <StackPanel Margin="16 0 0 0" VerticalAlignment="Center">
                <TextBlock Text="欢迎使用 StickyHomeworks3" FontSize="22" FontWeight="Bold" Foreground="#FF1E3A8A"/>
                <TextBlock Text="把作业贴在桌面上的小工具，支持富文本、科目分组和标签。"
                           Margin="0 4 0 0" Foreground="#FF64748B" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- 科目 -->
        <StackPanel Grid.Row="1" Margin="0 24 0 0">
            <TextBlock Text="选择你要用的科目" FontSize="15" FontWeight="SemiBold" Foreground="#FF1E293B"/>
            <TextBlock Text="之后可以在「设置 → 科目」里随时增删。" FontSize="12" Foreground="#FF64748B" Margin="0 2 0 10"/>
            <WrapPanel x:Name="SubjectsPanel"/>
        </StackPanel>

        <!-- 开机自启 -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="14" BorderBrush="#FFE2E8F0" BorderThickness="1">
            <DockPanel>
                <CheckBox x:Name="AutoStartCheck" DockPanel.Dock="Right" VerticalAlignment="Center"
                          Content="开机自启"/>
                <StackPanel>
                    <TextBlock Text="开机自动启动" FontWeight="SemiBold" Foreground="#FF1E293B"/>
                    <TextBlock Text="开机后自动把作业贴到桌面上。" FontSize="12" Foreground="#FF64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 按钮 -->
        <Button Grid.Row="3" x:Name="ButtonStart" Content="开始使用"
                Click="ButtonStart_OnClick"
                Margin="0 20 0 0" Height="40" FontSize="15"
                Background="#FF2563EB" Foreground="White" BorderThickness="0"
                HorizontalAlignment="Right" Width="140"/>
    </Grid>
</Window>
